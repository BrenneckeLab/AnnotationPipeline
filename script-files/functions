#!/bin/bash
#set -a to automatically export all functions
set -a

#*functions for download and demux
#download, convert to sam and split the files
downFunct() {
  set -ux
  currLIB=$1
  currJOB=$2
  locTMP=$3
  redCORES=$4
  TMPdir=$5
  arrayID=$6
  FOLDER=$7
  downDIR=$8
  LOGs=$9
  BCtype=${10}

  #@ rm -rf ${locTMP}/${currJOB}/*
  mkdir -p ${locTMP}/${currJOB}/

  if [[ -f ${TMPdir}URLs.txt ]]; then
    downNAME=$(echo $currLIB | awk '{n=split($1,X,/\//); print X[n]}')

    #pre-process fastq data to sam-format
    if [[ $currLIB == *"https"* ]]; then
      #if the input is a URL, download it
      if [[ -s ${downDIR}/${downNAME} && ! -f ${downDIR}/${downNAME}.wait ]]; then
        echo ${downNAME} already downloaded
        inFILE=${downDIR}/${downNAME}
      elif [[ ! -f ${downDIR}/${downNAME}.wait ]]; then
        touch ${downDIR}/${downNAME}.wait

        echo download ${downNAME}

        curl --retry 5 --retry-delay 300 --netrc-file ~/.AP_login.txt ${currLIB} --output ${downDIR}/${downNAME} || {
          echo download for ${currLIB} failed >>${locTMP}/${currJOB}/error.txt
          exit
        } 

        rm -rf ${downDIR}/${downNAME}.wait
      else
        echo ${downNAME} is currently downloading - waiting for it to finish
        SWITCH=N
        while [[ $SWITCH == N ]]; do
          sleep 5m 
          if [[ ! -f ${downDIR}/${currLIB}.bam.wait ]]; then
            SWITCH=Y
          fi
        done
        
      fi
      inFILE=${downDIR}/${downNAME}

    else
      inFILE=${currLIB}
    fi

    if [[ $inFILE == *"tar.gz"* ]]; then
      #unpack the tar.gz file
      tar -xzf $inFILE -C ${locTMP}${currJOB}/

      #paste R1, R2, I1, I2 fastq-files into a single sam file
      dirNAME=$(echo $downNAME | sed 's/\.tar\.gz//')
      if compgen -G "${locTMP}${currJOB}/${dirNAME}/fulllane/*_R2_*.fastq.gz"  > /dev/null; then
        #if R2 is present, use it
        seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_R1_*.fastq.gz | 
          paste - <(seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_I1_*.fastq.gz) <(seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_I2_*.fastq.gz) <(seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_R2_*.fastq.gz) | 
          mawk -v OFS="\t" '
          {
            print $1,77,"*",0,0,"*","*","0","0",$2,$3,"B2:Z:"$8,"Q2:Z:"$9,"BC:Z:"$5,"QT:Z:"$6
            print $1,141,"*",0,0,"*","*","0","0",$11,$12
          }' > ${locTMP}${currJOB}/input.sam
      else
        #if no R2 is present, use R1 only
        seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_R1_*.fastq.gz | 
          paste - <(seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_I1_*.fastq.gz) <(seqkit fx2tab --only-id ${locTMP}${currJOB}/${dirNAME}/fulllane/*_I2_*.fastq.gz) | 
          mawk -v OFS="\t" '
          {
            print $1,77,"*",0,0,"*","*","0","0",$2,$3,"B2:Z:"$8,"Q2:Z:"$9,"BC:Z:"$5,"QT:Z:"$6
          }' > ${locTMP}${currJOB}/input.sam
      fi

      READcommand="cat"
      inFILE=${locTMP}${currJOB}/input.sam
    
    fi

    #if the input is NGS-BAM simply convert to sam
    READcommand="samtools view -@ 2"
  fi


  rm -rf ${locTMP}${currJOB}/error.txt 
  rm -rf ${locTMP}${currJOB}/*.out.bam
    #time 
    $READcommand $inFILE| 
        mawk -v OUT=${locTMP}${currJOB}/ -v OFS="\t"  -v BCfile=${locTMP}BC_file.txt -v currN=$currJOB -v BCtype=$BCtype '
        BEGIN{
          #import BCs from FILE
          while((getline LINE < BCfile) > 0) {
            if( LINE !~ "i7"){
              split(LINE,splitLINE,/ |\t/)

              #i7
              n=split(splitLINE[1],spliti7,/~/)
              if(n>1){
                i7[splitLINE[4]]=spliti7[currN]
                print currN, spliti7[currN]
                split(spliti7[currN],splitPREi7,/:/)
              }else{
                i7[splitLINE[4]]=splitLINE[1]
                split(splitLINE[1],splitPREi7,/:/)
              }

              if(splitPREi7[3]!=""){
                if ( PRE[substr(splitPREi7[3],1,6)] != "" ) {
                  PRE[substr(splitPREi7[3],1,6)]=PRE[substr(splitPREi7[3],1,6)] ":!!:" splitLINE[4]
                }else{
                  PRE[substr(splitPREi7[3],1,6)]=splitLINE[4]
                }
              }else{
                NOi7="Y"
                if ( allLIBS != "" ) {
                  allLIBS=allLIBS ":!!:" splitLINE[4]
                }else{
                  allLIBS=splitLINE[4]
                }
              }
              
              #i5
              n=split(splitLINE[2],spliti5,/~/)
              if(n>1){
                i5[splitLINE[4]]=spliti5[currN]
              }else{
                i5[splitLINE[4]]=splitLINE[2]
              }
              #sRBC
              n=split(splitLINE[3],splitsRBC,/~/)
              if(n>1){
                sRBC[splitLINE[4]]=splitsRBC[currN]
              }else{
                sRBC[splitLINE[4]]=splitLINE[3]
              }
            }
          }   
        }
        {
          if(NR==1){
            for(i=1; i<=NF; i++){
              if($i~"BC:Z:") colBC=i
              if($i~"B2:Z:") colB2=i
            }
          }
          if ($2 == 77 || $2 == 4) {
            #reset current out-lib name
            currOUTlib=""

            #determine reduced ID list for looping only if i7 is present
            if(NOi7=="Y"){
              #perform sRBC demux if no i7 is present
              split(allLIBS,splitLIB,/:!!:/)

              for(i in splitLIB){
                LIB=splitLIB[i]
                split(sRBC[LIB],splitsRBC,/=/)
                currsRBC=splitsRBC[2] "AGATCGGAA"
                if($10 ~ currsRBC){
                  currOUTlib=LIB
                }
              }

            }else{
              #add all BCs to an array for BC stats
              BCsum[substr($colBC,6,8)":!:"substr($colB2,6,8)]+=1

              split($colBC,splitBC,/:/)
              split(PRE[substr(splitBC[3],1,6)],splitLIB,/:!!:/)

              #loop through all IDs and check for perfect barcode matches
              for(i in splitLIB){
                LIB=splitLIB[i]

                #test for i7 match
                if($colBC ~ i7[LIB]){
                  #print for cases with only i7              
                  if(i5[LIB]=="B2:Z:" && sRBC[LIB]=="sRBC="){
                    currOUTlib=LIB
                  }else{
                    
                    #test for i5 match in case i5 exists or if i5 is empty
                    if( i5[LIB] != "B2:Z:"){i5exists="YES"}
                    if($colB2 ~ i5[LIB] || i5[LIB] == "B2:Z:" ){
                      #print if no sRBC is present
                      if(sRBC[LIB]=="sRBC="){
                        currOUTlib=LIB
                      }else{
                        #add sRBC matchup
                        split(sRBC[LIB],splitsRBC,/=/)
                        if( BCtype ~ "Stark_3prime_BC_PROseq"){
                          currsRBC=splitsRBC[2] 
                          testSEQ=substr($10,1,4)

                          if(testSEQ == currsRBC){
                            currOUTlib=LIB
                            X=$10
                            $10=substr(X,15,1000)
                            X=$11
                            $11=substr(X,15,1000)
                          }
                        }else{
                          currsRBC=splitsRBC[2] "AGATCGGAA"
                          if($10 ~ currsRBC){
                            currOUTlib=LIB
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            if(currOUTlib !=""){
              print $0 | "samtools view -bS >> "OUT currOUTlib ".out.bam"
            }
            LIB=""
          }else{
            #print 2nd mate to same file as read before
            if(currOUTlib !=""){
              #remove 4 random nucleotides at the beginning of the 2nd mate of the Stark PROseq adaptors
              if( BCtype ~ "Stark_3prime_BC_PROseq"){
                $10=substr($10,5,1000)
                $11=substr($11,5,1000)
              }
              
              print $0 | "samtools view -bS >> "OUT currOUTlib ".out.bam"
            }
            currOUTlib=""
          }
        }
        END{
          if(NOi7!="Y"){
            for(BC in BCsum){
              split(BC, splitBC,/:!:/)
              if(i5exists == "YES"){
                print BCsum[BC],splitBC[1],splitBC[2] > OUT "BCsum.txt"
              }else{
                Y[splitBC[1]]+=BCsum[BC]
              }
            }
            if(i5exists != "YES"){
              for(BC in Y){
                print Y[BC],BC
              }
            }
          }
        }
        ' 2>&1 | tee ${locTMP}stderr.txt >${locTMP}${currJOB}/BCsum.txt

        ERROR=$(grep "EOF marker is absent. The input is probably truncated" ${locTMP}stderr.txt)
        if [[ -n $ERROR ]]; then
          echo "EOF marker is absent. The input is probably truncated" >>${locTMP}${currJOB}/error.txt
        fi
        ERROR=$(grep "samtools view: error reading file" ${locTMP}stderr.txt)
        if [[ -n $ERROR ]]; then
          echo "samtools view: error reading file" >>${locTMP}${currJOB}/error.txt
        fi
        ERROR=$(grep "samtools view: error closing" ${locTMP}stderr.txt)
        if [[ -n $ERROR ]]; then
          echo "samtools view: error closing" >>${locTMP}${currJOB}/error.txt
        fi

  if [[ -s ${locTMP}${currJOB}/BCsum.txt ]]; then
    sort -k1,1rn ${locTMP}${currJOB}/BCsum.txt >${LOGs}/all-BCs.array${arrayID}-file${currJOB}.txt
  fi
} 


