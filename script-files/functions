#demux sRBC
demuxFunctSRBC() {
  echo doing demuxFunctSRBC
  currJOB=$1
  locTMP=$2
  BC=$3
  BCtype=$4
  
  sRBCfile=${locTMP}sRBC_${BC}.fa
  currFILE="${locTMP}${currJOB}/${BC}.sam"

  mawk -v OFS="\t" '{print ">"$1 "\n" $10 }' $currFILE |
    cutadapt --overlap 5 -e 2 --cores=2 --no-indels -a file:$sRBCfile --max-n=200 -o "${locTMP}${currJOB}/demuxed-{name}.fasta" -

  rm -rf "${locTMP}${currJOB}/${BCtype}/demuxed-unknown.fasta"
}


#split bam file based on sRBC into individual libraries
extractFunctSRBC() {
    currJOB=$1
